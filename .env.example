# =========================================================
# YADMAN E-COMMERCE - PRODUCTION ENVIRONMENT CONFIGURATION
# =========================================================

# Database Connection (PostgreSQL - compatible with Supabase, Neon, Railway, AWS RDS, Self-hosted, etc.)
DATABASE_URL="postgresql://user:password@localhost:5432/yadman_db?schema=public"

# Authentication & Security Secrets
JWT_SECRET="replace-with-a-long-random-secret"
SESSION_SECRET="your-super-secure-session-secret"
ADMIN_DEFAULT_EMAIL="admin@yadman.ir"
ADMIN_DEFAULT_PASSWORD="ChangeThisSuperAdminPassword123!"

# Storage Provider: 'local' | 'supabase' | 's3' | 'r2' | 'cloudinary'
STORAGE_PROVIDER="local"
STORAGE_LOCAL_PATH="./uploads"

# Supabase Storage Configuration (When STORAGE_PROVIDER="supabase"):
# SUPABASE_URL="https://innchwiifzjstzcdxzav.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..." # Server-only service_role key
# SUPABASE_STORAGE_BUCKET="product-media" # Public bucket name in Supabase

# Optional S3/R2 settings:
# STORAGE_BUCKET=""
# STORAGE_ACCESS_KEY=""
# STORAGE_SECRET_KEY=""
# STORAGE_REGION=""
# STORAGE_ENDPOINT=""

# Payment Gateway Configuration (Abstraction for ZarinPal, IDPay, etc.)
PAYMENT_PROVIDER="zarinpal"
ZARINPAL_MERCHANT_ID="00000000-0000-0000-0000-000000000000"
PAYMENT_SANDBOX="true"
PAYMENT_CALLBACK_URL="http://localhost:3000/api/orders/payment/callback"

# Server & App URLs
PORT=3000
NODE_ENV="development"
APP_URL="http://localhost:3000"
CORS_ORIGIN="http://localhost:3000"

# Optional AI / Gemini API Key
GEMINI_API_KEY=""
